# OBD Telemetry — environment configuration.
# Copy this file to .env (at the repo root) and fill in the values.
# docker-compose reads .env from the same directory automatically.
# .env is .gitignored.

# ---------- Server-side secrets ----------
# Shared HMAC-equivalent secret for the X-API-Key header on
# /api/telemetry/batch, /api/fuel-logs, /api/maintenance. Must
# be >= 32 chars. The Android app must be configured with this
# exact value via the "API Server Config" card in the app.
OBD_API_KEY=

# Password for the Next.js dashboard's Basic Auth. Must be
# >= 12 chars.
DASHBOARD_PASSWORD=

# ---------- Public URLs ----------
# Public domain of the Fastify API (used by the dashboard to
# know where to fetch data). In production this is the
# Cloudflare-tunneled domain. Leave blank for LAN-only:
# the dashboard will fall back to the browser's hostname.
NEXT_PUBLIC_API_URL=https://obd-api.hon2838.name.my

# ---------- Build identity (optional) ----------
# These are baked into the Docker image at build time. The
# default values are placeholders; set them in CI or via
# `SERVICE_VERSION=... BUILD_COMMIT=$(git rev-parse --short HEAD) \
#   docker compose build`. They show up in /healthz and
# `docker inspect`.
SERVICE_VERSION=1.1.0
BUILD_COMMIT=unknown
BUILD_TIME=unknown
