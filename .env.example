# OBD Telemetry — environment configuration.
# Copy this file to .env (at the repo root) and fill in the values.
# docker-compose reads .env from the same directory automatically.
# .env is .gitignored.

# ---------- Server-side secrets ----------
# Master administrator API secret (minimum 32 characters).
# Used for server administration and operator API access.
# NOTE: For vehicle head units, use the QR/PIN pairing flow in the app
# to issue restricted, vehicle-scoped device tokens rather than this master key.
OBD_API_KEY=

# Optional one-time password for a fresh admin account. It must be at
# least 8 characters and must be changed after first login. If omitted,
# the server writes a generated password to the persistent data volume at
# /app/data/.initial_admin_secret with owner-only permissions.
OBD_INITIAL_ADMIN_PASSWORD=

# Optional Fastify trusted-proxy setting. Leave false when the API receives
# client traffic directly. Set true only behind a trusted, header-sanitizing
# proxy, or provide a comma-separated list of trusted proxy addresses/CIDRs.
OBD_TRUST_PROXY=false

# ---------- Public URLs ----------
# Public domain of the web dashboard (used for QR code pairing links and CORS).
# Default for live production:
DASHBOARD_PUBLIC_URL=https://obd.hon2838.name.my

# Public domain of the Fastify API (used by the dashboard and mobile app).
# Default for live production:
NEXT_PUBLIC_API_URL=https://obd-api.hon2838.name.my

# Optional comma-separated list of additional allowed CORS origins (e.g. for local testing/LAN)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://192.168.1.50:3003

# ---------- Build identity (optional) ----------
# These are baked into the Docker image at build time. The
# default values are placeholders; set them in CI or via
# `SERVICE_VERSION=... BUILD_COMMIT=$(git rev-parse --short HEAD) \
#   docker compose build`. They show up in /healthz and
# `docker inspect`.
SERVICE_VERSION=1.2.0
BUILD_COMMIT=unknown
BUILD_TIME=unknown
