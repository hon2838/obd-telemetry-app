<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="16dp"
    android:baselineAligned="false">

    <!-- Left Column: Controls and Status -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fillViewport="true"
        android:paddingRight="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/view_nav_bar" />
            <include layout="@layout/view_title_header" />
            <include layout="@layout/view_status_card" />
            <include layout="@layout/view_vehicle_card" />
            <include layout="@layout/view_bluetooth_card" />
            <include layout="@layout/view_api_config_card" />
            <include layout="@layout/view_settings_card" />
            <include layout="@layout/view_fuel_card" />
        </LinearLayout>
    </ScrollView>

    <!-- Right Column: Live Telemetry HUD and Head Unit Status -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:fillViewport="true"
        android:paddingLeft="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/view_telemetry_hud" />
            <include layout="@layout/view_head_unit_card" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
