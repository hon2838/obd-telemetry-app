<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="6dp">

    <!-- Compact Navigation Header with 48dp minimum touch target -->
    <LinearLayout
        android:id="@+id/navHeaderBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/card_bg"
        android:paddingHorizontal="12dp">

        <ImageButton
            android:id="@+id/btnNavMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_menu"
            android:tint="@color/accent_cyan"
            android:contentDescription="@string/cd_nav_menu" />

        <TextView
            android:id="@+id/tvNavCurrentTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="GATEWAY"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/btnToggleNavPills"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="56dp"
            android:paddingHorizontal="14dp"
            android:gravity="center"
            android:background="@drawable/nav_pill_inactive"
            android:text="PAGES ▾"
            android:textColor="#CCFFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Collapsible Horizontal Scrollable Tabs / Pills -->
    <HorizontalScrollView
        android:id="@+id/navPillsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:visibility="gone"
        android:layout_marginTop="6dp"
        tools:ignore="UseCompoundDrawables">

        <LinearLayout
            android:id="@+id/navPillsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/navGateway"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="56dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:layout_marginEnd="6dp"
                android:text="GATEWAY"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.03"
                android:textColor="#CCFFFFFF"
                android:background="@drawable/nav_pill_inactive"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/navDiagnostics"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="56dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:layout_marginEnd="6dp"
                android:text="DIAG"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.03"
                android:textColor="#CCFFFFFF"
                android:background="@drawable/nav_pill_inactive"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/navTrips"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="56dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:layout_marginEnd="6dp"
                android:text="TRIPS"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.03"
                android:textColor="#CCFFFFFF"
                android:background="@drawable/nav_pill_inactive"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/navFuel"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="56dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:layout_marginEnd="6dp"
                android:text="FUEL"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.03"
                android:textColor="#CCFFFFFF"
                android:background="@drawable/nav_pill_inactive"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/navPerf"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="56dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:layout_marginEnd="6dp"
                android:text="PERF"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.03"
                android:textColor="#CCFFFFFF"
                android:background="@drawable/nav_pill_inactive"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/navMaint"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="56dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="MAINT"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.03"
                android:textColor="#CCFFFFFF"
                android:background="@drawable/nav_pill_inactive"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
