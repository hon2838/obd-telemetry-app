<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- PRIMARY SCREEN: 100% Full-Bleed Cockpit Dashboard (Unified Portrait & Landscape) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Sleek Automotive Cockpit Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FF111317"
            android:paddingHorizontal="12dp">

            <!-- Hamburger Button to Open Controls Drawer (48dp x 48dp touch target) -->
            <ImageButton
                android:id="@+id/btnNavDrawer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_menu"
                android:tint="@color/accent_cyan"
                android:contentDescription="Open Controls Menu" />

            <!-- Cockpit Brand & Connection Dot -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="OBD COCKPIT"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <View
                android:id="@+id/cockpitStatusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/circle_indicator"
                android:backgroundTint="@color/accent_green" />

            <TextView
                android:id="@+id/tvCockpitStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Connected"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Active Preset Button (e.g. SPORT, CRUISER, HEALTH, CUSTOM - 44dp height / 48dp min touch target) -->
            <TextView
                android:id="@+id/btnPresetSelector"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minHeight="48dp"
                android:paddingHorizontal="14dp"
                android:gravity="center"
                android:background="@drawable/nav_pill_active"
                android:text="SPORT ▾"
                android:textColor="@color/accent_cyan"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:clickable="true"
                android:focusable="true" />

            <!-- Customize Dashboard Button (48dp x 48dp touch target) -->
            <ImageButton
                android:id="@+id/btnCustomizeCockpit"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_tune"
                android:tint="@color/text_secondary"
                android:contentDescription="Customize Dashboard" />

            <!-- Quick Telemetry Age Indicator -->
            <TextView
                android:id="@+id/tvCockpitAge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="LIVE"
                android:textColor="@color/accent_cyan"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Dynamic Customizable Gauges Grid -->
        <include
            layout="@layout/view_cockpit_dashboard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- SLIDE-OUT CONTROLS DRAWER -->
    <ScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="340dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#FF14161B"
        android:padding="14dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Drawer Header Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="GATEWAY &amp; CONTROLS"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <ImageButton
                    android:id="@+id/btnDrawerClose"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_close"
                    android:tint="@color/text_secondary"
                    android:contentDescription="Close Controls Menu" />
            </LinearLayout>

            <!-- Navigation Pages -->
            <include layout="@layout/view_nav_bar" />

            <!-- Hardware & Service Controls -->
            <include layout="@layout/view_status_card" />
            <include layout="@layout/view_vehicle_card" />
            <include layout="@layout/view_bluetooth_card" />
            <include layout="@layout/view_api_config_card" />
            <include layout="@layout/view_head_unit_card" />
            <include layout="@layout/view_settings_card" />
            <include layout="@layout/view_fuel_card" />
            <include layout="@layout/view_telemetry_hud" />

            <!-- Collapsible Raw Diagnostics / Extra Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="12dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnToggleSettings"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/btn_stop_bg"
                    android:text="@string/btn_show_settings"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/settingsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.drawerlayout.widget.DrawerLayout>
