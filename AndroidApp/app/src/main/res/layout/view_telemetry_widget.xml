<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gauge_card_bg"
    android:padding="8dp">

    <!-- 1. Dial Gauge Style -->
    <com.example.obdapp.CircularGaugeView
        android:id="@+id/dialGaugeView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- 2. Linear Bar Gauge Style -->
    <com.example.obdapp.LinearBarGaugeView
        android:id="@+id/barGaugeView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- 3. Digital HUD Style -->
    <LinearLayout
        android:id="@+id/digitalHudContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="2dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvDigitalTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="METRIC"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:letterSpacing="0.06" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="true"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="1dp">

            <TextView
                android:id="@+id/tvDigitalValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDigitalUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="km/h"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.example.obdapp.SparklineView
            android:id="@+id/digitalSparkline"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvDigitalMinMax"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="Min: 0  |  Max: 0"
            android:textColor="@color/text_secondary"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- 4. Graph Style (Full waveform) -->
    <LinearLayout
        android:id="@+id/graphContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvGraphTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="LIVE WAVEFORM"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGraphValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0"
                android:textColor="@color/accent_cyan"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.example.obdapp.SparklineView
            android:id="@+id/graphSparkline"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- Top-Right Format Switcher Button (1-Tap Cycle) -->
    <ImageButton
        android:id="@+id/btnCycleFormat"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="top|end"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_format"
        android:tint="@color/text_muted"
        android:contentDescription="Cycle gauge format" />

</FrameLayout>
