<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:padding="16dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="API SERVER CONFIG"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Server Base URL:"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etApiUrl"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/spinner_bg"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:inputType="textUri"
            android:hint="https://obd-api.hon2838.name.my" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="API Key (X-API-Key):"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etApiKey"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/spinner_bg"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:inputType="textVisiblePassword"
            android:hint="API key" />

        <Button
            android:id="@+id/btnApiSave"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="10dp"
            android:text="Save API Settings"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/spinner_bg" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="12dp"
            android:background="@color/surface_stroke" />

        <TextView
            android:id="@+id/tvDeviceTokenStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Device Authorization: Not Paired"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnPairDeviceCard"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="Pair Head Unit via PIN / QR"
            android:textColor="@color/btn_secondary_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/btn_diag_read_bg" />
    </LinearLayout>
</merge>
